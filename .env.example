# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local mongod)
# If omitted in local preview, HomeEase launches an embedded local MongoDB instance via mongodb-memory-server.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/homeease?retryWrites=true&w=majority"

# JWT Secret Key (use a long random string in production)
JWT_SECRET="replace-with-a-strong-random-jwt-secret"
JWT_EXPIRES_IN="7d"

# Client API Base URL (optional; defaults to /api on the same origin)
VITE_API_URL="/api"

# App URL
APP_URL="http://localhost:3000"
